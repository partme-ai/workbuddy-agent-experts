{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ResourceEstimateReceipt",
  "description": "Estimated resource cost for a hypothetical job submission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "parameters",
    "estimatedDiskBytes",
    "estimatedDurationSeconds",
    "estimatedPeakMemoryBytes",
    "warnings"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "EXPORT",
        "RENDER_STILL",
        "BAKE_POINT_CACHES",
        "RENDER_ANIMATION_FRAMES",
        "COMPOSE_VIDEO"
      ]
    },
    "parameters": {
      "type": "object"
    },
    "estimatedDiskBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Estimated disk space required in bytes"
    },
    "estimatedDurationSeconds": {
      "type": "number",
      "minimum": 0,
      "description": "Estimated wall-clock duration in seconds"
    },
    "estimatedPeakMemoryBytes": {
      "type": "integer",
      "minimum": 0,
      "description": "Estimated peak resident memory in bytes"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-fatal advisory notes about the estimate"
    }
  }
}
