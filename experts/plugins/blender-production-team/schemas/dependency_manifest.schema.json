{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "DependencyManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "projectPath",
    "generatedAt",
    "dependencies",
    "summary"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "const": "codex-blender/v1"
    },
    "projectPath": {
      "type": "string",
      "description": "Absolute path of the scanned project file"
    },
    "generatedAt": {
      "type": "string",
      "description": "ISO 8601 timestamp"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256", "bytes", "license", "accessible"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Resolved absolute path of the dependency"
          },
          "relativePath": {
            "type": "string",
            "description": "Path relative to the project directory, if inside project"
          },
          "kind": {
            "type": "string",
            "enum": [
              "IMAGE",
              "UDIM",
              "FONT",
              "AUDIO",
              "VIDEO",
              "IMAGE_SEQUENCE",
              "BLEND_LIBRARY",
              "SIMULATION_CACHE",
              "EXTENSION"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "license": {
            "type": "string",
            "description": "License identifier or 'unknown'"
          },
          "accessible": {
            "type": "boolean",
            "description": "Whether the file exists and is readable"
          },
          "warning": {
            "type": "string",
            "description": "Optional human-readable warning about the dependency"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "byKind", "accessible", "inaccessible"],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "byKind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "accessible": {
          "type": "integer",
          "minimum": 0
        },
        "inaccessible": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
