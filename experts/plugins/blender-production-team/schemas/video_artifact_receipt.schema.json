{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CodexBlenderVideoArtifactReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptVersion", "protocolVersion", "producer", "jobId", "path", "format", "bytes", "sha256", "sourceSequence", "media", "validation"],
  "properties": {
    "receiptVersion": {"type": "string", "const": "3.0.0"},
    "protocolVersion": {"type": "string", "const": "codex-blender/v1"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "const": "codex-blender"}, "version": {"type": "string"}}},
    "jobId": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]{1,80}$"},
    "path": {"type": "string"},
    "format": {"type": "string", "const": "mp4"},
    "bytes": {"type": "integer", "exclusiveMinimum": 0},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceSequence": {"type": "object", "additionalProperties": false, "required": ["jobId", "manifestPath", "manifestSha256"], "properties": {"jobId": {"type": "string", "pattern": "^job_[A-Za-z0-9_-]{1,80}$"}, "manifestPath": {"type": "string"}, "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "media": {"type": "object", "additionalProperties": false, "required": ["codec", "width", "height", "fps", "duration_seconds"], "properties": {"codec": {"type": "string", "enum": ["h264", "avc1"]}, "width": {"type": "integer", "minimum": 2}, "height": {"type": "integer", "minimum": 2}, "fps": {"type": "number", "exclusiveMinimum": 0}, "duration_seconds": {"type": "number", "exclusiveMinimum": 0}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["status", "checks"], "properties": {"status": {"type": "string", "enum": ["passed", "failed"]}, "checks": {"type": "array", "items": {"type": "string"}}}}
  }
}
