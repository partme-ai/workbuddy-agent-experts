{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CodexBlenderProductionProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "excludeDomains": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Domains excluded from the production catalog."
    },
    "excludeClasses": {
      "type": "array",
      "items": {"type": "string", "enum": ["expert", "experimental"]},
      "description": "Command classes excluded from the production catalog."
    }
  }
}
