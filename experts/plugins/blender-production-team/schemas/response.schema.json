{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CodexBlenderResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "requestId", "status", "sceneRevision", "changedObjects", "warnings"],
  "properties": {
    "protocolVersion": {"type": "string", "const": "codex-blender/v1"},
    "requestId": {"type": "string"},
    "status": {"type": "string", "enum": ["succeeded", "failed", "cancelled"]},
    "sceneRevision": {"type": "integer", "minimum": 0},
    "changedObjects": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "snapshotId": {"type": "string"},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"}
      }
    }
  }
}
