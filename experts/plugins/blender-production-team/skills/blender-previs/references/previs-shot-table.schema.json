{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/partme-ai/codex-blender-plugin/skills/codex-blender-previs/references/previs-shot-table.schema.json",
  "title": "White-model previs shot table",
  "description": "Frame-exact shot list driving a Blender white-model previs. Integer frames at the project fps; durations must sum to project.totalFrames.",
  "type": "object",
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "fps": {
          "type": "object",
          "properties": {
            "num": { "type": "integer", "minimum": 1 },
            "den": { "type": "integer", "minimum": 1 }
          },
          "required": ["num", "den"],
          "additionalProperties": false
        },
        "totalFrames": { "type": "integer", "minimum": 1 }
      },
      "required": ["id", "title", "fps", "totalFrames"],
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "roleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "primitive": {
            "type": "object",
            "properties": {
              "type": { "enum": ["cube", "cylinder", "sphere", "box", "capsule"] },
              "colorHex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
              "sizeHintMeters": {
                "type": "array",
                "items": { "type": "number", "exclusiveMinimum": 0 },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": ["type", "colorHex"],
            "additionalProperties": false
          }
        },
        "required": ["roleId", "label", "primitive"],
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "shotId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "startFrame": { "type": "integer", "minimum": 1 },
          "durationFrames": { "type": "integer", "minimum": 1 },
          "shotSize": {
            "enum": ["establishing", "wide", "medium", "closeup", "insert", "pov"]
          },
          "camera": {
            "type": "object",
            "properties": {
              "positionMeters": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "lookAtMeters": {
                "type": "array",
                "items": { "type": "number" },
                "minItems": 3,
                "maxItems": 3
              },
              "move": {
                "enum": ["static", "pan", "tilt", "dolly", "track", "crane", "handheld", "follow"]
              },
              "moveNote": { "type": "string" }
            },
            "required": ["positionMeters", "lookAtMeters", "move"],
            "additionalProperties": false
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "roleId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "positionMeters": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 3,
                  "maxItems": 3
                },
                "motionNote": { "type": "string" }
              },
              "required": ["roleId", "positionMeters"],
              "additionalProperties": false
            }
          },
          "note": { "type": "string" }
        },
        "required": ["shotId", "startFrame", "durationFrames", "shotSize", "camera", "subjects"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema_version", "project", "roles", "shots"],
  "additionalProperties": false
}
